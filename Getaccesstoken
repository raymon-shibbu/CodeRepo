= ()=>let
    body = "client_id=xxxx"
        & "&client_secret=yyyy"
        & "&grant_type=client_credentials"
        & "&resource=https://analysis.windows.net/powerbi/api"
    , Data = Json.Document(Web.Contents("https://login.microsoftonline.com/tenanatid/oauth2/token", [Headers=[#"Content-Type"="application/x-www-form-urlencoded"], Content=Text.ToBinary(body)])),
    access_token = Data[access_token]
in
    access_token
	
	
	
